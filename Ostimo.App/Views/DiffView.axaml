<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Ostimo.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="360"
             x:Class="Ostimo.App.Views.DiffView"
             x:DataType="vm:DiffViewModel">

  <!--
    Loading / error / empty / sections are mutually exclusive by construction
    in DiffViewModel (IsLoading is its own flag), exactly as before — only
    the presentation changed.
  -->
  <UserControl.Resources>

    <!-- One package row. Upgraded: old -> new. Added: new only (green).
         Removed: old only (red, whole row at 80% opacity so colour is never
         the only signal — OstimoUi.md §7). -->
    <DataTemplate x:Key="PackageChangeRowTemplate" x:DataType="vm:PackageChangeViewModel">
      <Border Classes="pkg" Classes.removed="{Binding IsRemoved}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Name}"
                     Classes="mono" FontSize="13"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Name}" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
            <Border Classes="chip old"
                    IsVisible="{Binding OldVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="mono old" Text="{Binding OldVersion}" FontSize="12" />
            </Border>
            <Path Data="M 4 12 L 20 12 M 14 6 L 20 12 L 14 18"
                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round"
                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                  IsVisible="{Binding ShowArrow}" />
            <Border Classes="chip new" Classes.single="{Binding !ShowArrow}"
                    IsVisible="{Binding NewVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="mono new" Classes.single="{Binding !ShowArrow}"
                         Text="{Binding NewVersion}" FontSize="12" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- One collapsible category. The header is a ToggleButton bound to
         IsExpanded (so collapsed state persists for the session, §3.2); the
         body eases open/closed by animating a vertical layout scale, which
         moves everything below it in step. -->
    <DataTemplate x:Key="DiffSectionTemplate" x:DataType="vm:DiffSectionViewModel">
      <Border Classes="section">
        <StackPanel>
          <ToggleButton Classes="sect" IsChecked="{Binding IsExpanded, Mode=TwoWay}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="4" Height="20" CornerRadius="2" Margin="0,0,12,0"
                      Classes="marker"
                      Classes.upgraded="{Binding IsUpgraded}"
                      Classes.added="{Binding IsAdded}"
                      Classes.removed="{Binding IsRemoved}" />
              <TextBlock Grid.Column="1" Text="{Binding Header}"
                         FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Path Grid.Column="2" Classes="chev" Data="M 6 9 L 12 15 L 18 9"
                    Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
            </Grid>
          </ToggleButton>

          <LayoutTransformControl Classes="collapse" Classes.open="{Binding IsExpanded}">
            <ItemsControl ItemsSource="{Binding Changes}"
                          ItemTemplate="{StaticResource PackageChangeRowTemplate}"
                          Margin="6,0,6,8" />
          </LayoutTransformControl>
        </StackPanel>
      </Border>
    </DataTemplate>

  </UserControl.Resources>

  <Panel>

    <!-- Loading: shimmering skeleton, never blocks what's on screen -->
    <StackPanel IsVisible="{Binding IsLoading}" Spacing="10">
      <TextBlock Text="Computing diff…" Classes="muted" />
      <Border Classes="skeleton" />
      <Border Classes="skeleton" Margin="0,0,70,0" />
      <Border Classes="skeleton" Margin="0,0,150,0" />
    </StackPanel>

    <!-- Error: real stderr, verbatim (OstimoUi.md §6) -->
    <Border IsVisible="{Binding HasError}" Padding="16" CornerRadius="14"
            Background="{DynamicResource DangerMutedBrush}"
            BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="Couldn't compute the diff:" FontWeight="SemiBold"
                   Foreground="{DynamicResource DangerBrush}" />
        <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding ErrorMessage}" Classes="mono" FontSize="13" TextWrapping="Wrap" />
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Empty: an explicit, friendly "nothing here", not a blank area -->
    <StackPanel IsVisible="{Binding IsEmptyDiff}" Spacing="12" Margin="0,22" HorizontalAlignment="Center">
      <Border Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Center"
              Background="{DynamicResource DiffAddedMutedBrush}">
        <Path Data="M 5 12 L 10 17 L 19 7"
              Stroke="{DynamicResource DiffAddedBrush}" StrokeThickness="2.4"
              StrokeLineCap="Round" StrokeJoin="Round"
              Width="22" Height="22" Stretch="Uniform"
              HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="No package differences between these two deployments."
                 Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>

    <!-- The diff: Upgraded -> Added -> Removed, fixed order from the ViewModel -->
    <ItemsControl ItemsSource="{Binding Sections}"
                  ItemTemplate="{StaticResource DiffSectionTemplate}"
                  IsVisible="{Binding !IsLoading}" />

  </Panel>

  <UserControl.Styles>

    <!-- Section card -->
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Header toggle (custom template: no Fluent chrome) -->
    <Style Selector="ToggleButton.sect">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Chrome" Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
              </Transitions>
            </Border.Transitions>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.sect:pointerover /template/ Border#Chrome">
      <Setter Property="Background" Value="{DynamicResource GlassBrush}" />
    </Style>
    <Style Selector="ToggleButton.sect:focus-visible /template/ Border#Chrome">
      <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    </Style>

    <!-- Chevron: points down when open, tips to the side when closed -->
    <Style Selector="Path.chev">
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.sect:checked Path.chev">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>

    <!-- Category markers -->
    <Style Selector="Border.marker.upgraded"><Setter Property="Background" Value="{DynamicResource DiffUpgradedBrush}" /></Style>
    <Style Selector="Border.marker.added"><Setter Property="Background" Value="{DynamicResource DiffAddedBrush}" /></Style>
    <Style Selector="Border.marker.removed"><Setter Property="Background" Value="{DynamicResource DiffRemovedBrush}" /></Style>

    <!-- Body expand / collapse: 220ms ease-out (OstimoUi.md §4 allows 150ms;
         a touch longer here because the section actually resizes). -->
    <Style Selector="LayoutTransformControl.collapse">
      <Setter Property="LayoutTransform" Value="scaleY(0.001)" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="LayoutTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="LayoutTransformControl.collapse.open">
      <Setter Property="LayoutTransform" Value="scaleY(1)" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!-- Package rows -->
    <Style Selector="Border.pkg">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.pkg:pointerover">
      <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}" />
    </Style>
    <Style Selector="Border.pkg.removed">
      <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Version chips -->
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border.chip.old"><Setter Property="Background" Value="{DynamicResource GlassStrongBrush}" /></Style>
    <Style Selector="Border.chip.new"><Setter Property="Background" Value="{DynamicResource DiffUpgradedMutedBrush}" /></Style>
    <Style Selector="Border.chip.new.single"><Setter Property="Background" Value="{DynamicResource DiffAddedMutedBrush}" /></Style>
    <Style Selector="Border.pkg.removed Border.chip.old"><Setter Property="Background" Value="{DynamicResource DiffRemovedMutedBrush}" /></Style>

    <Style Selector="TextBlock.mono.old"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style>
    <Style Selector="TextBlock.mono.new"><Setter Property="Foreground" Value="{DynamicResource DiffUpgradedBrush}" /></Style>
    <Style Selector="TextBlock.mono.new.single"><Setter Property="Foreground" Value="{DynamicResource DiffAddedBrush}" /></Style>
    <Style Selector="Border.pkg.removed TextBlock.mono.old"><Setter Property="Foreground" Value="{DynamicResource DiffRemovedBrush}" /></Style>

  </UserControl.Styles>

</UserControl>
